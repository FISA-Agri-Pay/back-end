pipeline {
    agent any

    environment {
        // HARBOR_REGISTRY, HARBOR_PROJECT, GITOPS_REPO_URL 은
        // Jenkins > Manage Jenkins > System > Global Properties 에서 등록

        // 실제 생성될 이미지명
        SERVICE = 'service-batch'
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    env.IMAGE_TAG = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    echo "Image tag: ${env.IMAGE_TAG}"

                    def prevCommit = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT
                    if (!prevCommit) {
                        echo "이전 성공 빌드 없음 - 전체 빌드 실행"
                        env.SKIP_BUILD = 'false'
                        return
                    }

                    def changedFiles
                    try {
                        changedFiles = sh(
                            returnStdout: true,
                            script: "git diff --name-only ${prevCommit} HEAD"
                        ).trim()
                    } catch (e) {
                        echo "git diff 실패 (얕은 clone 또는 커밋 누락) — 전체 빌드 실행"
                        env.SKIP_BUILD = 'false'
                        return
                    }
                    echo "Changed files since ${prevCommit}:\n${changedFiles}"

                    def watchPaths = ['service-batch/', 'common-core/']
                    def hasChanges = !changedFiles.isEmpty() && changedFiles.split('\n').any { file ->
                        watchPaths.any { path -> file.startsWith(path) }
                    }

                    env.SKIP_BUILD = hasChanges ? 'false' : 'true'
                    if (env.SKIP_BUILD == 'true') {
                        echo "${watchPaths} 관련 변경 없음 - 빌드 스킵"
                        currentBuild.result = 'NOT_BUILT'
                    }
                }
            }
        }

        stage('Build') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                sh './gradlew :service-batch:bootJar -x test'
            }
        }

        stage('Docker Build & Push') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'harbor-credentials',
                    usernameVariable: 'HARBOR_USER',
                    passwordVariable: 'HARBOR_PASS'
                )]) {
                    sh """
                        echo \${HARBOR_PASS} | docker login ${HARBOR_REGISTRY} -u \${HARBOR_USER} --password-stdin
                        docker build -t ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:${env.IMAGE_TAG} \
                            -f ${SERVICE}/Dockerfile ${SERVICE}/
                        docker push ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:${env.IMAGE_TAG}
                        docker logout ${HARBOR_REGISTRY}
                        docker rmi ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:${env.IMAGE_TAG}
                    """
                }
            }
        }

        stage('Update GitOps') {
            when {
                allOf {
                    expression { env.SKIP_BUILD != 'true' }
                    expression { env.GIT_BRANCH == 'dev' || env.GIT_BRANCH == 'origin/dev' }
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'gitlab-credentials',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PASS'
                )]) {
                    sh """
                        rm -rf gitops
                        git -c credential.helper="!f() { echo username=\${GIT_USER}; echo password=\${GIT_PASS}; }; f" clone ${GITOPS_REPO_URL} gitops
                        cd gitops
                        git config credential.helper "!f() { echo username=\${GIT_USER}; echo password=\${GIT_PASS}; }; f"
                        sed -i "s|image: ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:.*|image: ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:${env.IMAGE_TAG}|" on-prem/${SERVICE}/cronjob.yaml
                        git config user.email "jenkins@kkpp.com"
                        git config user.name "Jenkins"
                        git add .
                        git diff --staged --quiet || git commit -m "ci: update ${SERVICE} image tag to ${env.IMAGE_TAG}"
                        git push origin main
                    """
                }
            }
        }
    }

    post {
        always {
            sh 'rm -rf gitops'
            cleanWs()
        }
    }
}
