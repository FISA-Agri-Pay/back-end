pipeline {
    agent any

    environment {
        // HARBOR_REGISTRY, HARBOR_PROJECT, GITOPS_REPO_URL 은
        // Jenkins > Manage Jenkins > System > Global Properties 에서 등록

        // 실제 생성될 이미지명
        SERVICE = 'service-core'
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    env.IMAGE_TAG = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    echo "Image tag: ${env.IMAGE_TAG}"

                    def prevCommit = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT
                    if (!prevCommit) {
                        echo "이전 성공 빌드 없음 - 전체 빌드 실행"
                        env.SKIP_BUILD = 'false'
                        return
                    }

                    def changedFiles
                    try {
                        changedFiles = sh(
                            returnStdout: true,
                            script: "git diff --name-only ${prevCommit} HEAD"
                        ).trim()
                    } catch (e) {
                        echo "git diff 실패 (얕은 clone 또는 커밋 누락) — 전체 빌드 실행"
                        env.SKIP_BUILD = 'false'
                        return
                    }
                    echo "Changed files since ${prevCommit}:\n${changedFiles}"

                    def watchPaths = [
                        'service-core/',
                        'common-core/',
                        'common-security/',
                        'build.gradle',
                        'settings.gradle',
                        'gradle/'
                    ]
                    def hasChanges = !changedFiles.isEmpty() && changedFiles.split('\n').any { file ->
                        watchPaths.any { path -> file.startsWith(path) }
                    }

                    env.SKIP_BUILD = hasChanges ? 'false' : 'true'
                    if (env.SKIP_BUILD == 'true') {
                        echo "${watchPaths} 관련 변경 없음 - 빌드 스킵"
                        currentBuild.result = 'NOT_BUILT'
                    }
                }
            }
        }

        stage('Build') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                sh './gradlew :service-core:bootJar -x test'
            }
        }

        stage('Docker Build & Push') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'harbor-credentials',
                    usernameVariable: 'HARBOR_USER',
                    passwordVariable: 'HARBOR_PASS'
                )]) {
                    sh """
                        export DOCKER_BUILDKIT=1
                        echo \${HARBOR_PASS} | docker login ${HARBOR_REGISTRY} -u \${HARBOR_USER} --password-stdin
                        docker build -t ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:${env.IMAGE_TAG} \
                            -f ${SERVICE}/Dockerfile ${SERVICE}
                        docker push ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:${env.IMAGE_TAG}
                        docker logout ${HARBOR_REGISTRY}
                        docker rmi ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:${env.IMAGE_TAG}
                    """
                }
            }
        }

        stage('Update GitOps') {
            when {
                allOf {
                    expression { env.SKIP_BUILD != 'true' }
                    expression { env.GIT_BRANCH == 'dev' || env.GIT_BRANCH == 'origin/dev' }
                }
            }
            steps {
                script {
                    int gitopsAttempt = 0
                    int gitopsMaxAttempts = 3
                    try {
                        retry(gitopsMaxAttempts) {
                            gitopsAttempt++
                            withCredentials([usernamePassword(
                                credentialsId: 'gitlab-credentials',
                                usernameVariable: 'GIT_USER',
                                passwordVariable: 'GIT_PASS'
                            )]) {
                                sh """
                                    rm -rf gitops
                                    git -c credential.helper="!f() { echo username=\${GIT_USER}; echo password=\${GIT_PASS}; }; f" clone ${GITOPS_REPO_URL} gitops
                                    cd gitops
                                    git config credential.helper "!f() { echo username=\${GIT_USER}; echo password=\${GIT_PASS}; }; f"
                                    sed -i "s|image: ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:.*|image: ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE}:${env.IMAGE_TAG}|" on-prem/${SERVICE}/deployment.yaml
                                    git config user.email "jenkins@kkpp.com"
                                    git config user.name "Jenkins"
                                    git add .
                                    git diff --staged --quiet || git commit -m "ci: update ${SERVICE} image tag to ${env.IMAGE_TAG}"
                                    echo "metric=gitops_update_attempt service=${SERVICE} gitops_path=on-prem/${SERVICE} attempt=${gitopsAttempt} max_attempts=${gitopsMaxAttempts} image_tag=${env.IMAGE_TAG}"
                                    set +e
                                    git pull --rebase origin main > git-pull-rebase.log 2>&1
                                    pull_status=\$?
                                    cat git-pull-rebase.log
                                    if [ "\$pull_status" -ne 0 ]; then
                                        echo "metric=gitops_update_failure service=${SERVICE} gitops_path=on-prem/${SERVICE} attempt=${gitopsAttempt} max_attempts=${gitopsMaxAttempts} operation=git-pull-rebase reason=git-rebase-conflict status=failed image_tag=${env.IMAGE_TAG}"
                                        exit "\$pull_status"
                                    fi
                                    git push origin main > git-push.log 2>&1
                                    push_status=\$?
                                    cat git-push.log
                                    if [ "\$push_status" -ne 0 ]; then
                                        if grep -Eiq "rejected|failed to push|cannot lock ref|fetch first|non-fast-forward|incorrect old value" git-push.log; then
                                            echo "metric=gitops_update_failure service=${SERVICE} gitops_path=on-prem/${SERVICE} attempt=${gitopsAttempt} max_attempts=${gitopsMaxAttempts} operation=git-push reason=git-rebase-conflict status=failed image_tag=${env.IMAGE_TAG}"
                                        else
                                            echo "metric=gitops_update_failure service=${SERVICE} gitops_path=on-prem/${SERVICE} attempt=${gitopsAttempt} max_attempts=${gitopsMaxAttempts} operation=git-push reason=git-push-failure status=failed image_tag=${env.IMAGE_TAG}"
                                        fi
                                        exit "\$push_status"
                                    fi
                                    echo "metric=gitops_update_success service=${SERVICE} gitops_path=on-prem/${SERVICE} attempt=${gitopsAttempt} max_attempts=${gitopsMaxAttempts} image_tag=${env.IMAGE_TAG}"
                                """
                            }
                        }
                    } catch (err) {
                        echo "metric=gitops_update_retries_exhausted service=${env.SERVICE} gitops_path=on-prem/${env.SERVICE} attempts=${gitopsAttempt} max_attempts=${gitopsMaxAttempts} reason=git-rebase-conflict status=failed image_tag=${env.IMAGE_TAG}"
                        throw err
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.SKIP_BUILD != 'true' && (env.GIT_BRANCH == 'dev' || env.GIT_BRANCH == 'origin/dev')) {
                    withCredentials([string(credentialsId: 'ARGOCD_TOKEN', variable: 'ARGOCD_AUTH_TOKEN')]) {
                        def syncStart = System.currentTimeMillis()
                        sh """
                            export ARGOCD_SERVER=argocd.dev6.fisa
                            argocd app terminate-op service-core --insecure --grpc-web || true
                            argocd app wait service-core --operation --insecure --grpc-web || true
                            argocd app sync service-core --insecure --grpc-web
                            argocd app wait service-core --health --timeout 300 --insecure --grpc-web
                        """
                        def syncDuration = (System.currentTimeMillis() - syncStart) / 1000
                        def totalDuration = (System.currentTimeMillis() - currentBuild.startTimeInMillis) / 1000
                        echo "========================================="
                        echo "ArgoCD 배포 시간: ${syncDuration}초"
                        echo "E2E 총 배포 시간: ${totalDuration}초"
                        echo "========================================="
                    }
                }
            }
        }
        always {
            sh 'rm -rf gitops'
            cleanWs()
        }
    }
}